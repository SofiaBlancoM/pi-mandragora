<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="es.cifpcarlos3.pimandragora.presentation.authors.controllers.pages.AuthorCreateController"
      stylesheets="@author-create.css" styleClass="root-container">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Añadir Nuevo Autor" styleClass="header-label"/>

    <GridPane hgap="10.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
        </columnConstraints>

        <children>
            <Label text="Nombre:" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" promptText="Ej: Gabriel García Márquez" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Biografía:" GridPane.rowIndex="1" />
            <TextArea fx:id="bioArea" prefHeight="150.0" promptText="Escribe una breve reseña..." wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        </children>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button onAction="#handleCancel" text="Cancelar" styleClass="secondary-button" />
        <Button onAction="#handleSave" text="Crear Autor" styleClass="primary-button" />
    </HBox>
</VBox>