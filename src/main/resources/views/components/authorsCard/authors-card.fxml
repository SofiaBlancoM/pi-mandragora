<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Priority?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="es.cifpcarlos3.pimandragora.presentation.authors.controllers.components.AuthorCardController"
      stylesheets="@authors-card.css"
      fx:id="root"
      prefWidth="220"
      maxWidth="220"
      minHeight="180"
      maxHeight="210"
      spacing="0"
      styleClass="author-card">

    <VBox spacing="5" VBox.vgrow="ALWAYS" styleClass="card-content">
        <Label fx:id="nameLabel" styleClass="author-name-title" />

        <VBox VBox.vgrow="ALWAYS" />

        <Label fx:id="bioLabel"
               styleClass="author-bio-short"
               wrapText="true"
               maxHeight="70"
               alignment="BOTTOM_LEFT" />
    </VBox>
</VBox>